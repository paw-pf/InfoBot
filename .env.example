# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
REPORT_CHAT_ID=
REPORT_THREAD_ID=

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_FILE=credentials.json

# Allowed users (Telegram user IDs, comma-separated)
# Leave empty to allow all users
ALLOWED_USERS=

# Report chat ID (optional)
# If set, reports from private chats will be duplicated to this chat
# Get chat ID: add @userinfobot to your group, it will show the ID
# Group IDs are negative (e.g., -1001234567890)

# Report thread ID (optional)
# If set, reports will be sent to a specific thread/topic in a forum group
# For format like 3344197135/2, use REPORT_THREAD_ID=2

# Shift time configuration
# Shifts starting before this hour are considered "Night"
NIGHT_SHIFT_START_HOUR=20
# Shifts starting after this hour are considered "Day"  
DAY_SHIFT_START_HOUR=6
